{
    "name": "obelaw/systemone-clef",
    "description": "Cloudflare Workers AI Clef driver adapter for Obelaw SystemOne Decision Engine.",
    "keywords": ["laravel", "obelaw", "systemone", "clef", "cloudflare", "ai", "driver"],
    "license": "MIT",
    "authors": [
        {
            "name": "Karim Mohamed",
            "email": "komicho1996@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "obelaw/systemone": "*",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Obelaw\\SystemOne\\Clef\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Obelaw\\SystemOne\\Clef\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obelaw\\SystemOne\\Clef\\ClefServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    }
}
